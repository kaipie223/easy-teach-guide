# Easy-Teach 环境变量模板
# 复制此文件为 .env 并填入真实值
# cp .env.example .env

# DeepSeek API（陈澜负责申请，全队共用）
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Whisper 模型大小：tiny / small / medium
WHISPER_MODEL=small

# ChromaDB 存储目录
CHROMA_PERSIST_DIR=./chroma_data

# 数据库
DATABASE_URL=sqlite:///./data.db

# 用户上传目录
UPLOAD_DIR=./backend/uploads

# 课件输出目录
OUTPUT_DIR=./output
